{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudfall.internal/schemas/v1/deployment-receipt.schema.json",
  "title": "Cloudfall domain deployment receipt",
  "type": "object",
  "properties": {
    "apiVersion": {
      "$ref": "common.schema.json#/$defs/apiVersion"
    },
    "kind": {
      "const": "DeploymentReceipt"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "properties": {
        "domain": {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        "server": {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        "deployedAt": {
          "type": "string",
          "format": "date-time"
        },
        "configurationPath": {
          "$ref": "common.schema.json#/$defs/absolutePath"
        },
        "configurationSha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "previousConfigurationSha256": {
          "description": "sha256 of the file at configurationPath before this run rendered it, or null when no file was there",
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "domain",
        "server",
        "deployedAt",
        "configurationPath",
        "configurationSha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
