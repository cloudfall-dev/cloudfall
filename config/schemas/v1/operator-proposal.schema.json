{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudfall.internal/schemas/v1/operator-proposal.schema.json",
  "title": "Cloudfall operator proposal receipt",
  "type": "object",
  "properties": {
    "apiVersion": {
      "$ref": "common.schema.json#/$defs/apiVersion"
    },
    "kind": {
      "const": "OperatorProposal"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "description": "running: approved and its execution started, with no outcome recorded yet; found so after the execution's process ended, it was interrupted, and it is not approved again. interrupted: a running receipt a person closed once they confirmed its execution is dead; interruption names who and when, and it no longer blocks a new proposal for the same trigger.",
          "enum": [
            "proposed",
            "executed",
            "verified",
            "failed",
            "running",
            "interrupted"
          ]
        },
        "interruption": {
          "description": "Who closed a running receipt as interrupted, once they confirmed its execution is dead, and when. Set when the status is interrupted.",
          "type": "object",
          "properties": {
            "confirmedBy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "confirmedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "confirmedBy",
            "confirmedAt"
          ],
          "additionalProperties": false
        },
        "writerVersion": {
          "type": "string",
          "description": "The Cloudfall version that last wrote this receipt. A receipt written before this field names none.",
          "minLength": 1,
          "maxLength": 64
        },
        "trigger": {
          "type": "object",
          "properties": {
            "kind": {
              "description": "What raised the proposal: a firing alert, an audited drift, or an agent's call of a gated MCP tool (agent, with request).",
              "enum": [
                "alert",
                "drift",
                "agent"
              ]
            },
            "request": {
              "description": "The agent's call: the MCP tool, its arguments without the ones the server binds, and the reason the agent gave, if any.",
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "arguments": {
                  "type": "object"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "required": [
                "tool",
                "arguments"
              ],
              "additionalProperties": false
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{16}$"
            },
            "alert": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "cloudfallRule": {
                  "$ref": "common.schema.json#/$defs/resourceId"
                },
                "severity": {
                  "enum": [
                    "warning",
                    "critical"
                  ]
                },
                "environment": {
                  "$ref": "common.schema.json#/$defs/resourceId"
                },
                "server": {
                  "$ref": "common.schema.json#/$defs/resourceId"
                },
                "service": {
                  "$ref": "common.schema.json#/$defs/resourceId"
                },
                "activeAt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "required": [
                "name",
                "cloudfallRule",
                "severity",
                "environment",
                "server",
                "service",
                "activeAt"
              ],
              "additionalProperties": false
            },
            "drift": {
              "type": "object",
              "properties": {
                "server": {
                  "$ref": "common.schema.json#/$defs/resourceId"
                },
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "minItems": 1
                }
              },
              "required": [
                "server",
                "checks"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "fingerprint"
          ],
          "oneOf": [
            {
              "required": [
                "alert"
              ]
            },
            {
              "required": [
                "drift"
              ]
            },
            {
              "required": [
                "request"
              ]
            }
          ],
          "additionalProperties": false
        },
        "diagnosis": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "minItems": 1
            }
          },
          "required": [
            "summary",
            "evidence"
          ],
          "additionalProperties": false
        },
        "operation": {
          "type": "object",
          "properties": {
            "kind": {
              "description": "The operation class: the operator's converge-services and converge-baseline, or the class of the gated MCP tool an agent called.",
              "enum": [
                "converge-services",
                "converge-baseline",
                "deploy",
                "rollback",
                "restart",
                "migrate",
                "data-copy",
                "domains-apply",
                "converge-domains"
              ]
            },
            "server": {
              "description": "The one server an alert or drift proposal runs on; required for those.",
              "$ref": "common.schema.json#/$defs/resourceId"
            },
            "servers": {
              "description": "Every server the run changes; required for an agent proposal, empty for a run that changes no declared server (only a person approves it).",
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/resourceId"
              },
              "uniqueItems": true
            },
            "environments": {
              "description": "The environments of those servers; required for an agent proposal, empty when it names no server.",
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/resourceId"
              },
              "uniqueItems": true
            },
            "service": {
              "$ref": "common.schema.json#/$defs/resourceId"
            },
            "command": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "command"
          ],
          "additionalProperties": false
        },
        "binding": {
          "description": "What an agent proposal was computed against: the sha256 of the plan the command computed, and in a git project the HEAD commit and the digest of uncommitted changes outside decisions/, record/ and tmp/ (D-20).",
          "type": "object",
          "properties": {
            "planSha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "gitCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
            },
            "worktreeDigest": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          },
          "required": [
            "planSha256"
          ],
          "additionalProperties": false
        },
        "approval": {
          "type": "object",
          "properties": {
            "mode": {
              "description": "human: a person approved it; autonomous: the operator ran it on a policy grant; agent: an agent's call ran on a policy grant.",
              "enum": [
                "human",
                "autonomous",
                "agent"
              ]
            },
            "policy": {
              "$ref": "common.schema.json#/$defs/resourceId"
            },
            "grant": {
              "description": "The operation class the policy granted an agent run.",
              "enum": [
                "converge-services",
                "converge-baseline",
                "deploy",
                "rollback",
                "restart",
                "migrate",
                "data-copy",
                "domains-apply",
                "converge-domains"
              ]
            },
            "client": {
              "description": "The MCP client that called, as it named itself at initialize; unknown when it did not.",
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "\\S"
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "\\S"
                }
              },
              "required": [
                "name",
                "version"
              ],
              "additionalProperties": false
            },
            "via": {
              "description": "How a person's approval arrived: terminal when a person typed the proposal id at a terminal. A human approval written before this field reads as unknown; an autonomous one has none.",
              "type": "string",
              "enum": [
                "terminal",
                "unknown"
              ]
            }
          },
          "required": [
            "mode"
          ],
          "if": {
            "properties": {
              "mode": {
                "const": "autonomous"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "not": {
              "required": [
                "via"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "agent"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "required": [
                  "policy",
                  "grant",
                  "client"
                ],
                "not": {
                  "required": [
                    "via"
                  ]
                }
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "grant"
                      ]
                    },
                    {
                      "required": [
                        "client"
                      ]
                    }
                  ]
                }
              }
            }
          ],
          "additionalProperties": false
        },
        "outcome": {
          "type": "object",
          "properties": {
            "executedAt": {
              "type": "string",
              "format": "date-time"
            },
            "verifiedAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "result": {
              "enum": [
                "verified",
                "failed"
              ]
            },
            "detail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "ownedRoles": {
              "description": "Owner role passwords the run set: the reference, the key, and the value's SHA-256, never the value",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "service": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                  },
                  "owner": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,62}$"
                  },
                  "passwordRef": {
                    "type": "object",
                    "properties": {
                      "environment": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                      },
                      "path": {
                        "type": "string",
                        "pattern": "^/"
                      },
                      "key": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,254}$"
                      }
                    },
                    "required": [
                      "environment",
                      "path",
                      "key"
                    ],
                    "additionalProperties": false
                  },
                  "key": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,254}$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "service",
                  "owner",
                  "passwordRef",
                  "key",
                  "sha256"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "executedAt",
            "verifiedAt",
            "result",
            "detail"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "createdAt",
        "status",
        "trigger",
        "diagnosis",
        "operation"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "running"
              }
            }
          },
          "then": {
            "required": [
              "approval"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "interrupted"
              }
            }
          },
          "then": {
            "required": [
              "approval",
              "interruption"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "trigger": {
                "properties": {
                  "kind": {
                    "const": "agent"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "trigger"
            ]
          },
          "then": {
            "properties": {
              "trigger": {
                "required": [
                  "request"
                ]
              },
              "operation": {
                "required": [
                  "servers",
                  "environments"
                ]
              }
            },
            "required": [
              "binding"
            ]
          },
          "else": {
            "properties": {
              "trigger": {
                "not": {
                  "required": [
                    "request"
                  ]
                }
              },
              "operation": {
                "required": [
                  "server"
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
