{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudfall.internal/schemas/v1/operator-proposal.schema.json",
  "title": "Cloudfall operator proposal receipt",
  "type": "object",
  "properties": {
    "apiVersion": {
      "$ref": "common.schema.json#/$defs/apiVersion"
    },
    "kind": {
      "const": "OperatorProposal"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "proposed",
            "executed",
            "verified",
            "failed"
          ]
        },
        "trigger": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "alert",
                "drift"
              ]
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{16}$"
            },
            "alert": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "cloudfallRule": {
                  "$ref": "common.schema.json#/$defs/resourceId"
                },
                "severity": {
                  "enum": [
                    "warning",
                    "critical"
                  ]
                },
                "environment": {
                  "$ref": "common.schema.json#/$defs/resourceId"
                },
                "server": {
                  "$ref": "common.schema.json#/$defs/resourceId"
                },
                "service": {
                  "$ref": "common.schema.json#/$defs/resourceId"
                },
                "activeAt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "required": [
                "name",
                "cloudfallRule",
                "severity",
                "environment",
                "server",
                "service",
                "activeAt"
              ],
              "additionalProperties": false
            },
            "drift": {
              "type": "object",
              "properties": {
                "server": {
                  "$ref": "common.schema.json#/$defs/resourceId"
                },
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "minItems": 1
                }
              },
              "required": [
                "server",
                "checks"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "fingerprint"
          ],
          "oneOf": [
            {
              "required": [
                "alert"
              ]
            },
            {
              "required": [
                "drift"
              ]
            }
          ],
          "additionalProperties": false
        },
        "diagnosis": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "minItems": 1
            }
          },
          "required": [
            "summary",
            "evidence"
          ],
          "additionalProperties": false
        },
        "operation": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "converge-services",
                "converge-baseline"
              ]
            },
            "server": {
              "$ref": "common.schema.json#/$defs/resourceId"
            },
            "service": {
              "$ref": "common.schema.json#/$defs/resourceId"
            },
            "command": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "server",
            "command"
          ],
          "additionalProperties": false
        },
        "approval": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "human",
                "autonomous"
              ]
            },
            "policy": {
              "$ref": "common.schema.json#/$defs/resourceId"
            },
            "via": {
              "description": "How a person's approval arrived: terminal when a person typed the proposal id at a terminal. A human approval written before this field reads as unknown; an autonomous one has none.",
              "type": "string",
              "enum": [
                "terminal",
                "unknown"
              ]
            }
          },
          "required": [
            "mode"
          ],
          "if": {
            "properties": {
              "mode": {
                "const": "autonomous"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "not": {
              "required": [
                "via"
              ]
            }
          },
          "additionalProperties": false
        },
        "outcome": {
          "type": "object",
          "properties": {
            "executedAt": {
              "type": "string",
              "format": "date-time"
            },
            "verifiedAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "result": {
              "enum": [
                "verified",
                "failed"
              ]
            },
            "detail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "ownedRoles": {
              "description": "Owner role passwords the run set: the reference, the key, and the value's SHA-256, never the value",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "service": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                  },
                  "owner": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,62}$"
                  },
                  "passwordRef": {
                    "type": "object",
                    "properties": {
                      "environment": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                      },
                      "path": {
                        "type": "string",
                        "pattern": "^/"
                      },
                      "key": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,254}$"
                      }
                    },
                    "required": [
                      "environment",
                      "path",
                      "key"
                    ],
                    "additionalProperties": false
                  },
                  "key": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,254}$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "service",
                  "owner",
                  "passwordRef",
                  "key",
                  "sha256"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "executedAt",
            "verifiedAt",
            "result",
            "detail"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "createdAt",
        "status",
        "trigger",
        "diagnosis",
        "operation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
