{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudfall.internal/schemas/v1/logging-stack.schema.json",
  "title": "Cloudfall logging stack",
  "x-cloudfall-kind": "LoggingStack",
  "type": "object",
  "properties": {
    "apiVersion": {
      "$ref": "common.schema.json#/$defs/apiVersion"
    },
    "kind": {
      "const": "LoggingStack"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "properties": {
        "environment": {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        "migration": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "parallel"
                },
                "preserveLegacyAgents": {
                  "const": true
                }
              },
              "required": [
                "mode",
                "preserveLegacyAgents"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "none"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            }
          ]
        },
        "software": {
          "type": "object",
          "properties": {
            "lokiPackageVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "grafanaPackageVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "alloyPackageVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "prometheusPackageVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "lokiPackageVersion",
            "grafanaPackageVersion",
            "alloyPackageVersion"
          ],
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "properties": {
            "backend": {
              "type": "object",
              "properties": {
                "listenAddress": {
                  "const": "127.0.0.1"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 65535
                },
                "storagePath": {
                  "$ref": "common.schema.json#/$defs/absolutePath"
                },
                "retentionHours": {
                  "type": "integer",
                  "minimum": 24,
                  "maximum": 8760
                },
                "storagePool": {
                  "$ref": "common.schema.json#/$defs/resourceId"
                }
              },
              "required": [
                "listenAddress",
                "port",
                "storagePath",
                "retentionHours"
              ],
              "additionalProperties": false
            },
            "collection": {
              "type": "object",
              "properties": {
                "intervalSeconds": {
                  "type": "integer",
                  "minimum": 5,
                  "maximum": 300
                }
              },
              "required": [
                "intervalSeconds"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "backend",
            "collection"
          ],
          "additionalProperties": false
        },
        "backend": {
          "type": "object",
          "properties": {
            "server": {
              "$ref": "common.schema.json#/$defs/resourceId"
            },
            "listenAddress": {
              "const": "127.0.0.1"
            },
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            },
            "storage": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "filesystem"
                },
                "path": {
                  "$ref": "common.schema.json#/$defs/absolutePath"
                },
                "pool": {
                  "$ref": "common.schema.json#/$defs/resourceId"
                }
              },
              "required": [
                "type",
                "path"
              ],
              "additionalProperties": false
            },
            "retentionHours": {
              "type": "integer",
              "minimum": 24,
              "maximum": 8760
            }
          },
          "required": [
            "server",
            "listenAddress",
            "port",
            "storage",
            "retentionHours"
          ],
          "additionalProperties": false
        },
        "gateway": {
          "type": "object",
          "properties": {
            "serverName": {
              "type": "string",
              "format": "hostname"
            },
            "listenAddress": {
              "enum": [
                "0.0.0.0",
                "::"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            },
            "tls": {
              "type": "object",
              "properties": {
                "certificatePath": {
                  "$ref": "common.schema.json#/$defs/absolutePath"
                },
                "keyPath": {
                  "$ref": "common.schema.json#/$defs/absolutePath"
                },
                "clientCaPath": {
                  "$ref": "common.schema.json#/$defs/absolutePath"
                }
              },
              "required": [
                "certificatePath",
                "keyPath",
                "clientCaPath"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "serverName",
            "listenAddress",
            "port",
            "tls"
          ],
          "additionalProperties": false
        },
        "grafana": {
          "type": "object",
          "properties": {
            "listenAddress": {
              "const": "127.0.0.1"
            },
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            },
            "adminPasswordPath": {
              "$ref": "common.schema.json#/$defs/absolutePath"
            }
          },
          "required": [
            "listenAddress",
            "port",
            "adminPasswordPath"
          ],
          "additionalProperties": false
        },
        "alerting": {
          "type": "object",
          "properties": {
            "alertmanager": {
              "type": "object",
              "properties": {
                "listenAddress": {
                  "const": "127.0.0.1"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 65535
                },
                "packageVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "listenAddress",
                "port"
              ],
              "additionalProperties": false
            },
            "receivers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "common.schema.json#/$defs/resourceId"
                  },
                  "webhook": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500,
                        "pattern": "^https?://[^\\u0000-\\u001f\\u007f ]+$"
                      }
                    },
                    "required": [
                      "url"
                    ],
                    "additionalProperties": false
                  },
                  "email": {
                    "type": "object",
                    "properties": {
                      "smarthost": {
                        "type": "string",
                        "pattern": "^[a-z0-9.-]+:[0-9]{1,5}$"
                      },
                      "from": {
                        "type": "string",
                        "maxLength": 200,
                        "pattern": "^[^@\\s]+@[^@\\s]+$"
                      },
                      "to": {
                        "type": "string",
                        "maxLength": 200,
                        "pattern": "^[^@\\s]+@[^@\\s]+$"
                      },
                      "authUsername": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                      },
                      "authPasswordFile": {
                        "$ref": "common.schema.json#/$defs/absolutePath"
                      }
                    },
                    "required": [
                      "smarthost",
                      "from",
                      "to"
                    ],
                    "additionalProperties": false,
                    "dependentRequired": {
                      "authUsername": [
                        "authPasswordFile"
                      ],
                      "authPasswordFile": [
                        "authUsername"
                      ]
                    }
                  }
                },
                "required": [
                  "id"
                ],
                "oneOf": [
                  {
                    "required": [
                      "webhook"
                    ]
                  },
                  {
                    "required": [
                      "email"
                    ]
                  }
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "alertmanager",
            "receivers"
          ],
          "additionalProperties": false
        },
        "collectors": {
          "type": "object",
          "properties": {
            "servers": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/resourceId"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "clientTls": {
              "type": "object",
              "properties": {
                "caPath": {
                  "$ref": "common.schema.json#/$defs/absolutePath"
                },
                "certificatePath": {
                  "$ref": "common.schema.json#/$defs/absolutePath"
                },
                "keyPath": {
                  "$ref": "common.schema.json#/$defs/absolutePath"
                }
              },
              "required": [
                "caPath",
                "certificatePath",
                "keyPath"
              ],
              "additionalProperties": false
            },
            "journal": {
              "type": "object",
              "properties": {
                "enabled": {
                  "const": true
                },
                "maxAgeHours": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 168
                }
              },
              "required": [
                "enabled",
                "maxAgeHours"
              ],
              "additionalProperties": false
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "common.schema.json#/$defs/resourceId"
                  },
                  "path": {
                    "$ref": "common.schema.json#/$defs/absolutePath"
                  },
                  "servers": {
                    "type": "array",
                    "items": {
                      "$ref": "common.schema.json#/$defs/resourceId"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "application": {
                    "$ref": "common.schema.json#/$defs/resourceId"
                  },
                  "component": {
                    "$ref": "common.schema.json#/$defs/resourceId"
                  }
                },
                "required": [
                  "id",
                  "path",
                  "servers"
                ],
                "additionalProperties": false,
                "dependentRequired": {
                  "component": [
                    "application"
                  ]
                }
              }
            }
          },
          "required": [
            "servers",
            "clientTls",
            "journal",
            "files"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "environment",
        "migration",
        "software",
        "metrics",
        "backend",
        "gateway",
        "grafana",
        "collectors"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
