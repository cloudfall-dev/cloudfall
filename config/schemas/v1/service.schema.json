{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudfall.internal/schemas/v1/service.schema.json",
  "title": "Cloudfall infrastructure service",
  "x-cloudfall-kind": "Service",
  "$defs": {
    "postgresDatabaseName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "postgresRoleName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "secretValueReference": {
      "type": "object",
      "properties": {
        "environment": {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        "path": {
          "$ref": "common.schema.json#/$defs/absolutePath"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "environment",
        "path",
        "key"
      ],
      "additionalProperties": false
    },
    "remoteAccess": {
      "type": "object",
      "properties": {
        "listenAddress": {
          "type": "string",
          "anyOf": [
            {
              "format": "ipv4"
            },
            {
              "format": "ipv6"
            }
          ],
          "not": {
            "enum": [
              "0.0.0.0",
              "::"
            ]
          }
        },
        "allowedSources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 49
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "listenAddress",
        "allowedSources"
      ],
      "additionalProperties": false
    },
    "systemdCalendar": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9 *:,.^~/-]+$"
    }
  },
  "type": "object",
  "properties": {
    "apiVersion": {
      "$ref": "common.schema.json#/$defs/apiVersion"
    },
    "kind": {
      "const": "Service"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "properties": {
        "serviceKind": {
          "enum": [
            "postgresql",
            "redis"
          ]
        },
        "environment": {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        "server": {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        "bind": {
          "type": "object",
          "properties": {
            "address": {
              "const": "127.0.0.1"
            },
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            }
          },
          "required": [
            "address",
            "port"
          ],
          "additionalProperties": false
        },
        "postgresql": {
          "type": "object",
          "properties": {
            "majorVersion": {
              "type": "string",
              "pattern": "^[0-9]{2}$"
            },
            "packageVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "databases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "$ref": "#/$defs/postgresDatabaseName"
                  },
                  "application": {
                    "$ref": "common.schema.json#/$defs/resourceId"
                  },
                  "owner": {
                    "$ref": "#/$defs/postgresRoleName"
                  },
                  "passwordRef": {
                    "$ref": "#/$defs/secretValueReference"
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false,
                "oneOf": [
                  {
                    "required": [
                      "application"
                    ]
                  },
                  {
                    "required": [
                      "owner"
                    ]
                  }
                ],
                "dependentRequired": {
                  "owner": [
                    "passwordRef"
                  ]
                },
                "dependentSchemas": {
                  "application": {
                    "not": {
                      "required": [
                        "passwordRef"
                      ]
                    }
                  }
                }
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "remoteAccess": {
              "$ref": "#/$defs/remoteAccess"
            }
          },
          "required": [
            "majorVersion",
            "databases"
          ],
          "additionalProperties": false
        },
        "backup": {
          "type": "object",
          "properties": {
            "directory": {
              "$ref": "common.schema.json#/$defs/absolutePath"
            },
            "onCalendar": {
              "$ref": "#/$defs/systemdCalendar"
            },
            "restoreCheckOnCalendar": {
              "$ref": "#/$defs/systemdCalendar"
            },
            "retentionDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650
            }
          },
          "required": [
            "directory",
            "onCalendar",
            "retentionDays"
          ],
          "additionalProperties": false
        },
        "redis": {
          "type": "object",
          "properties": {
            "packageVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxmemoryMb": {
              "type": "integer",
              "minimum": 16,
              "maximum": 1048576
            },
            "appendOnly": {
              "type": "boolean"
            }
          },
          "required": [
            "maxmemoryMb",
            "appendOnly"
          ],
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "properties": {
            "enabled": {
              "const": true
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "serviceKind",
        "environment",
        "server",
        "bind",
        "backup"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "serviceKind": {
                "const": "postgresql"
              }
            }
          },
          "then": {
            "required": [
              "postgresql"
            ],
            "not": {
              "required": [
                "redis"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "serviceKind": {
                "const": "redis"
              }
            }
          },
          "then": {
            "required": [
              "redis"
            ],
            "not": {
              "required": [
                "postgresql"
              ]
            }
          }
        }
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
