{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudfall.internal/schemas/v1/service.schema.json",
  "title": "Cloudfall infrastructure service",
  "x-cloudfall-kind": "Service",
  "$defs": {
    "postgresDatabaseName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "postgresRoleName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "secretValueReference": {
      "type": "object",
      "properties": {
        "environment": {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        "path": {
          "$ref": "common.schema.json#/$defs/absolutePath"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      },
      "required": [
        "environment",
        "path",
        "key"
      ],
      "additionalProperties": false
    },
    "remoteAccess": {
      "type": "object",
      "properties": {
        "listenAddress": {
          "type": "string",
          "anyOf": [
            {
              "format": "ipv4"
            },
            {
              "format": "ipv6"
            }
          ],
          "not": {
            "enum": [
              "0.0.0.0",
              "::"
            ]
          }
        },
        "allowedSources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 49
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "listenAddress",
        "allowedSources"
      ],
      "additionalProperties": false
    },
    "systemdCalendar": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9 *:,.^~/-]+$"
    },
    "elasticsearchIndexPattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-z0-9._*+-]+$"
    },
    "elasticsearchIndexPatterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/elasticsearchIndexPattern"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "elasticsearch": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "heapMb": {
          "type": "integer",
          "minimum": 512,
          "maximum": 31744
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/resourceId"
          },
          "minItems": 1
        },
        "clusterName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "existingCluster": {
          "type": "object",
          "properties": {
            "seedHosts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 261,
                "pattern": "^(\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?):[0-9]{1,5}$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "caCertificateFile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "seedHosts",
            "caCertificateFile"
          ],
          "additionalProperties": false
        },
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "access": {
                "enum": [
                  "read",
                  "write"
                ]
              },
              "indexPatterns": {
                "$ref": "#/$defs/elasticsearchIndexPatterns"
              },
              "passwordRef": {
                "$ref": "#/$defs/secretValueReference"
              }
            },
            "required": [
              "name",
              "access",
              "indexPatterns",
              "passwordRef"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "remoteAccess": {
          "$ref": "#/$defs/remoteAccess"
        },
        "snapshotRepository": {
          "type": "object",
          "properties": {
            "type": {
              "const": "s3"
            },
            "bucket": {
              "type": "string",
              "minLength": 3,
              "maxLength": 63,
              "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
            },
            "endpoint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]{1,5})?$"
            },
            "basePath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
            },
            "credentialsRef": {
              "$ref": "#/$defs/secretValueReference"
            }
          },
          "required": [
            "type",
            "bucket",
            "endpoint",
            "credentialsRef"
          ],
          "additionalProperties": false
        },
        "restoreCheckIndices": {
          "$ref": "#/$defs/elasticsearchIndexPatterns"
        }
      },
      "required": [
        "version",
        "heapMb"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "apiVersion": {
      "$ref": "common.schema.json#/$defs/apiVersion"
    },
    "kind": {
      "const": "Service"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "properties": {
        "serviceKind": {
          "enum": [
            "postgresql",
            "redis",
            "elasticsearch"
          ]
        },
        "environment": {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        "server": {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        "bind": {
          "type": "object",
          "properties": {
            "address": {
              "const": "127.0.0.1"
            },
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            }
          },
          "required": [
            "address",
            "port"
          ],
          "additionalProperties": false
        },
        "postgresql": {
          "type": "object",
          "properties": {
            "majorVersion": {
              "type": "string",
              "pattern": "^[0-9]{2}$"
            },
            "packageVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "databases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "$ref": "#/$defs/postgresDatabaseName"
                  },
                  "application": {
                    "$ref": "common.schema.json#/$defs/resourceId"
                  },
                  "owner": {
                    "$ref": "#/$defs/postgresRoleName"
                  },
                  "passwordRef": {
                    "$ref": "#/$defs/secretValueReference"
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false,
                "oneOf": [
                  {
                    "required": [
                      "application"
                    ]
                  },
                  {
                    "required": [
                      "owner"
                    ]
                  }
                ],
                "dependentRequired": {
                  "owner": [
                    "passwordRef"
                  ]
                },
                "dependentSchemas": {
                  "application": {
                    "not": {
                      "required": [
                        "passwordRef"
                      ]
                    }
                  }
                }
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "remoteAccess": {
              "$ref": "#/$defs/remoteAccess"
            }
          },
          "required": [
            "majorVersion",
            "databases"
          ],
          "additionalProperties": false
        },
        "backup": {
          "type": "object",
          "properties": {
            "directory": {
              "$ref": "common.schema.json#/$defs/absolutePath"
            },
            "onCalendar": {
              "$ref": "#/$defs/systemdCalendar"
            },
            "restoreCheckOnCalendar": {
              "$ref": "#/$defs/systemdCalendar"
            },
            "retentionDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650
            }
          },
          "required": [
            "directory",
            "onCalendar",
            "retentionDays"
          ],
          "additionalProperties": false
        },
        "redis": {
          "type": "object",
          "properties": {
            "packageVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxmemoryMb": {
              "type": "integer",
              "minimum": 16,
              "maximum": 1048576
            },
            "appendOnly": {
              "type": "boolean"
            }
          },
          "required": [
            "maxmemoryMb",
            "appendOnly"
          ],
          "additionalProperties": false
        },
        "elasticsearch": {
          "$ref": "#/$defs/elasticsearch"
        },
        "metrics": {
          "type": "object",
          "properties": {
            "enabled": {
              "const": true
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "serviceKind",
        "environment",
        "server",
        "bind",
        "backup"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "serviceKind": {
                "const": "postgresql"
              }
            }
          },
          "then": {
            "required": [
              "postgresql"
            ],
            "not": {
              "required": [
                "redis"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "serviceKind": {
                "const": "redis"
              }
            }
          },
          "then": {
            "required": [
              "redis"
            ],
            "not": {
              "required": [
                "postgresql"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "serviceKind": {
                "const": "elasticsearch"
              }
            }
          },
          "then": {
            "required": [
              "elasticsearch"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "postgresql"
                  ]
                },
                {
                  "required": [
                    "redis"
                  ]
                }
              ]
            }
          },
          "else": {
            "not": {
              "required": [
                "elasticsearch"
              ]
            }
          }
        }
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
