{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudfall.internal/schemas/v1/release-receipt.schema.json",
  "title": "Cloudfall component release receipt",
  "description": "One receipt per component and deploy run, with one entry per server under spec.servers naming the release that server ended on. A receipt written before entries (spec.server, one server) still validates and reads as a one-entry list.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "$ref": "common.schema.json#/$defs/apiVersion"
    },
    "kind": {
      "const": "ReleaseReceipt"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "spec": {
      "if": {
        "required": [
          "servers"
        ]
      },
      "then": {
        "$ref": "#/$defs/runSpec"
      },
      "else": {
        "$ref": "#/$defs/singleServerSpec"
      }
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "$defs": {
    "releaseId": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7,40}$"
    },
    "optionalReleaseId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7,40}$"
    },
    "commandHealthCheck": {
      "type": "object",
      "properties": {
        "type": {
          "const": "command"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 255
        },
        "timedOut": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "command",
        "attempts",
        "exitCode",
        "timedOut"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "timedOut": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "exitCode": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "exitCode": {
            "type": "integer"
          }
        }
      }
    },
    "releaseCommand": {
      "type": "object",
      "properties": {
        "server": {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "workingDirectory": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "exitCode": {
          "const": 0
        },
        "outputTail": {
          "description": "The end of the command's output, as releases before 0.8.0 wrote it into the receipt. No longer written: the output is raw application output and may hold a secret, so it stays in the project's tmp/ and the receipt names it under output; cloudfall config upgrade moves an old tail there.",
          "type": "string",
          "maxLength": 2000
        },
        "output": {
          "$ref": "#/$defs/outputReference"
        }
      },
      "required": [
        "server",
        "command",
        "workingDirectory",
        "exitCode"
      ],
      "not": {
        "required": [
          "outputTail",
          "output"
        ]
      },
      "additionalProperties": false
    },
    "outputReference": {
      "description": "Where the end of the command's output was kept on the management host, outside the committed record, and the SHA-256 of what was kept. The path is relative to the project unless the output directory was outside it. The file is not committed and may be gone, or replaced by a later run: compare its SHA-256 before treating it as this run's output.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "gateOutcome": {
      "if": {
        "properties": {
          "healthCheckPassed": {
            "const": false
          }
        },
        "required": [
          "healthCheckPassed"
        ]
      },
      "then": {
        "properties": {
          "healthCheck": {
            "properties": {
              "exitCode": {
                "not": {
                  "const": 0
                }
              }
            }
          }
        },
        "required": [
          "healthCheck"
        ]
      },
      "else": {
        "properties": {
          "healthCheck": {
            "properties": {
              "exitCode": {
                "const": 0
              },
              "timedOut": {
                "const": false
              }
            }
          }
        }
      }
    },
    "serverEntry": {
      "type": "object",
      "properties": {
        "server": {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        "release": {
          "$ref": "#/$defs/optionalReleaseId"
        },
        "previousRelease": {
          "$ref": "#/$defs/optionalReleaseId"
        },
        "deployedAt": {
          "type": "string",
          "format": "date-time"
        },
        "healthCheckPassed": {
          "type": "boolean"
        },
        "rolledBack": {
          "type": "boolean"
        },
        "healthCheck": {
          "$ref": "#/$defs/commandHealthCheck"
        },
        "removedReleases": {
          "description": "The releases the deploy removed from this server once its gate passed there, keeping deployment.retainReleases; absent when no cleanup ran.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/releaseId"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "server",
        "release",
        "previousRelease",
        "deployedAt",
        "healthCheckPassed",
        "rolledBack"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/gateOutcome"
        },
        {
          "if": {
            "properties": {
              "healthCheckPassed": {
                "const": false
              }
            },
            "required": [
              "healthCheckPassed"
            ]
          },
          "then": {
            "properties": {
              "rolledBack": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "healthCheckPassed": {
                "const": false
              }
            },
            "required": [
              "healthCheckPassed"
            ]
          },
          "then": {
            "not": {
              "required": [
                "removedReleases"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "rolledBack": {
                "const": false
              }
            },
            "required": [
              "rolledBack"
            ]
          },
          "then": {
            "properties": {
              "release": {
                "$ref": "#/$defs/releaseId"
              }
            }
          }
        }
      ]
    },
    "runSpec": {
      "type": "object",
      "properties": {
        "component": {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        "release": {
          "$ref": "#/$defs/releaseId"
        },
        "artifactSha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "releaseCommand": {
          "$ref": "#/$defs/releaseCommand"
        },
        "servers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serverEntry"
          },
          "minItems": 1
        }
      },
      "required": [
        "component",
        "release",
        "artifactSha256",
        "servers"
      ],
      "additionalProperties": false
    },
    "singleServerSpec": {
      "type": "object",
      "properties": {
        "component": {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        "server": {
          "$ref": "common.schema.json#/$defs/resourceId"
        },
        "release": {
          "$ref": "#/$defs/releaseId"
        },
        "artifactSha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "deployedAt": {
          "type": "string",
          "format": "date-time"
        },
        "previousRelease": {
          "$ref": "#/$defs/optionalReleaseId"
        },
        "healthCheckPassed": {
          "type": "boolean"
        },
        "healthCheck": {
          "$ref": "#/$defs/commandHealthCheck"
        },
        "releaseCommand": {
          "$ref": "#/$defs/releaseCommand"
        }
      },
      "required": [
        "component",
        "server",
        "release",
        "artifactSha256",
        "deployedAt",
        "previousRelease",
        "healthCheckPassed"
      ],
      "additionalProperties": false,
      "$ref": "#/$defs/gateOutcome"
    }
  }
}
