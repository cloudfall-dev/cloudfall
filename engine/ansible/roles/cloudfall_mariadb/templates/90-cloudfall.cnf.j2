# Managed by Cloudfall for service {{ cloudfall_mariadb_service.id }}; a change
# here is drift. Settings of your own go in a file that sorts before this one.
[mariadbd]
bind-address = {{ cloudfall_mariadb_service.bind.address }}
port = {{ cloudfall_mariadb_service.bind.port }}
datadir = {{ cloudfall_mariadb_data_path }}
innodb_buffer_pool_size = {{ cloudfall_mariadb_service.mariadb.innodbBufferPoolMb }}M
character-set-server = utf8mb4
# The data volume's ext4 root holds lost+found, which is no database.
ignore-db-dirs = lost+found
