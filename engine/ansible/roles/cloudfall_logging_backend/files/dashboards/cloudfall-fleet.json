{
  "uid": "cloudfall-fleet",
  "title": "Fleet",
  "description": "Every server of the environment at a glance (Cloudfall S-016)",
  "tags": [
    "cloudfall"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 42,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "cloudfall-prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info, environment)",
          "refId": "environment-var"
        },
        "definition": "label_values(node_uname_info, environment)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "cloudfall"
      ],
      "asDropdown": true,
      "title": "Cloudfall",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "table",
      "title": "Servers",
      "description": "Last sample: seconds since the server's collector last reported",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudfall-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cloudfall-prometheus"
          },
          "expr": "time() - max by (server) (timestamp(node_uname_info{environment=\"$environment\"}))",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cloudfall-prometheus"
          },
          "expr": "100 * (1 - avg by (server) (rate(node_cpu_seconds_total{environment=\"$environment\", mode=\"idle\"}[5m])))",
          "refId": "B",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cloudfall-prometheus"
          },
          "expr": "100 * (1 - max by (server) (node_memory_MemAvailable_bytes{environment=\"$environment\"}) / max by (server) (node_memory_MemTotal_bytes{environment=\"$environment\"}))",
          "refId": "C",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cloudfall-prometheus"
          },
          "expr": "max by (server) (100 * (1 - node_filesystem_avail_bytes{environment=\"$environment\", fstype=~\"ext4|xfs\"} / node_filesystem_size_bytes{environment=\"$environment\", fstype=~\"ext4|xfs\"}))",
          "refId": "D",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cloudfall-prometheus"
          },
          "expr": "max by (server) (node_load1{environment=\"$environment\"})",
          "refId": "E",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Last sample",
              "Value #B": "CPU busy",
              "Value #C": "Memory used",
              "Value #D": "Fullest filesystem",
              "Value #E": "Load 1m"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last sample"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU busy"
            },
