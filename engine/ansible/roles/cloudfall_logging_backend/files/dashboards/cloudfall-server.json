    {
      "type": "timeseries",
      "title": "CPU by mode",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudfall-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cloudfall-prometheus"
          },
          "expr": "100 * sum by (mode) (rate(node_cpu_seconds_total{environment=\"$environment\", server=\"$server\", mode!=\"idle\"}[$__rate_interval])) / scalar(count(node_cpu_seconds_total{environment=\"$environment\", server=\"$server\", mode=\"idle\"}))",
          "refId": "A",
          "legendFormat": "{{mode}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
