    {
      "type": "stat",
      "title": "Fullest filesystem",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudfall-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cloudfall-prometheus"
          },
          "expr": "max(100 * (1 - node_filesystem_avail_bytes{environment=\"$environment\", server=\"$server\", fstype=~\"ext4|xfs\"} / node_filesystem_size_bytes{environment=\"$environment\", server=\"$server\", fstype=~\"ext4|xfs\"}))",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "id": 4,
      "gridPos": {
        "x": 18,
