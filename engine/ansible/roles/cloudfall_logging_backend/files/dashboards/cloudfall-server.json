        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "cloudfall-prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info, environment)",
          "refId": "environment-var"
        },
        "definition": "label_values(node_uname_info, environment)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      },
      {
        "name": "server",
        "label": "Server",
