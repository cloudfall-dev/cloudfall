#!/usr/bin/python3
# Managed by Cloudfall. Local changes will be overwritten.
"""{{ cloudfall_elasticsearch_snapshot_action }} of Elasticsearch service {{ cloudfall_elasticsearch_service.id }} (S-012).

backup: counts the documents of each index the restore drill restores
(every index restoreCheckIndices matches, or the smallest index) and writes
the counts as one document, named after the snapshot, into Cloudfall's own
index cloudfall-snapshot-counts. It then takes the snapshot
cloudfall-<timestamp> of every index, that one included, and the cluster
state into the repository the converge registered, waits for it, fails
unless its state is SUCCESS, and deletes Cloudfall's snapshots of the
service older than retentionDays, never the newest, with their counts.

restore-check: verifies the repository, restores the counts index of the
newest snapshot under the prefix cloudfall-restore-check-, reads the counts
the snapshot holds, restores those indices under the same prefix with no
replicas, waits for them to be green, compares each document count with the
recorded one, and deletes the restored copies, also when a step failed.

The cloudfall password is read from its file and sent only in the
Authorization header; nothing here prints it.
"""

import base64
import json
import re
import signal
import ssl
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

ACTION = {{ cloudfall_elasticsearch_snapshot_action | to_json }}
SERVICE = {{ cloudfall_elasticsearch_service.id | to_json }}
# The node's API as the role reaches it: plain HTTP on loopback, or, with
# remoteAccess, HTTPS on the listen address verified against the project CA.
URL = {{ cloudfall_elasticsearch_api_url | to_json }}
CA_FILE = {{ cloudfall_elasticsearch_api_ca | to_json }}
PASSWORD_FILE = {{ cloudfall_elasticsearch_password_path | to_json }}
REPOSITORY = {{ cloudfall_elasticsearch_snapshot_repository | to_json }}
COUNTS_INDEX = {{ cloudfall_elasticsearch_snapshot_counts_index | to_json }}
RETENTION_DAYS = {{ cloudfall_elasticsearch_service.backup.retentionDays | int }}
RESTORE_CHECK_INDICES = {{ cloudfall_elasticsearch_service.elasticsearch.restoreCheckIndices | default([]) | to_json }}
POLL_SECONDS = {{ cloudfall_elasticsearch_snapshot_poll_seconds | int }}
WAIT_SECONDS = {{ cloudfall_elasticsearch_snapshot_wait_seconds | int }}

SNAPSHOT_NAME = re.compile(r"cloudfall-[0-9]{8}-[0-9]{6}")
RESTORE_PREFIX = "cloudfall-restore-check-"
BYTE_UNITS = {"b": 0, "kb": 1, "mb": 2, "gb": 3, "tb": 4, "pb": 5}
# The names one request path carries, well inside the node's 4kb request line.
LINE_ROOM = 3000
# Only the service and snapshot fields are indexed; the counts stay in the
# source, so no index name ever becomes a field of the mapping.
COUNTS_INDEX_BODY = {
    "settings": {"index.number_of_shards": 1, "index.auto_expand_replicas": "0-1"},
    "mappings": {
        "dynamic": False,
        "properties": {
            "service": {"type": "keyword"},
            "snapshot": {"type": "keyword"},
        },
    },
}


class Failure(Exception):
    """A step failed; its message says which and why."""


def authorization():
    password = Path(PASSWORD_FILE).read_text(encoding="utf-8").strip()
    if not password:
        raise Failure(f"{PASSWORD_FILE} is empty")
    token = base64.b64encode(f"cloudfall:{password}".encode()).decode()
    return f"Basic {token}"


AUTHORIZATION = ""
# HTTPS verifies the node against the project CA only, never the system's.
TLS = ssl.create_default_context(cafile=CA_FILE) if CA_FILE else None


def request(method, path, body=None, *, answers=(), missing=False):
    """Send one request; a 404 is None when ``missing``, a code in ``answers`` is read."""
    data = None if body is None else json.dumps(body).encode()
    call = urllib.request.Request(URL + path, data=data, method=method)
    call.add_header("Authorization", AUTHORIZATION)
    if data is not None:
        call.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(
            call, timeout=WAIT_SECONDS, context=TLS
        ) as response:
            raw = response.read()
    except urllib.error.HTTPError as error:
        if missing and error.code == 404:
            return None
        raw = error.read()
        if error.code not in answers:
            detail = raw.decode("utf-8", "replace")[:600]
            raise Failure(f"{method} {path} answered {error.code}: {detail}") from None
    return json.loads(raw) if raw else {}


def quoted(*names):
    return ",".join(urllib.parse.quote(name, safe="") for name in names)


def batches(names):
    """Split ``names`` into lists whose quoted form fits one request line.

    A node refuses a request line longer than http.max_initial_line_length
    (4kb by default), so a request naming many indices or snapshots in its
    path is sent in parts.
    """
    batch, size = [], 0
    for name in names:
        width = len(quoted(name)) + 1
        if batch and size + width > LINE_ROOM:
            yield batch
            batch, size = [], 0
        batch.append(name)
        size += width
    if batch:
        yield batch


def ours(snapshot):
    metadata = snapshot.get("metadata") or {}
    return (
        SNAPSHOT_NAME.fullmatch(snapshot["snapshot"]) is not None
        and metadata.get("takenBy") == "cloudfall"
        and metadata.get("service") == SERVICE
    )


def our_snapshots():
    """Every snapshot of the repository Cloudfall took of this service."""
    answer = request("GET", f"/_snapshot/{quoted(REPOSITORY)}/cloudfall-*")
    return [snapshot for snapshot in answer["snapshots"] if ours(snapshot)]


def newest(snapshots):
    done = [snapshot for snapshot in snapshots if snapshot["state"] == "SUCCESS"]
    return max(done, key=lambda snapshot: snapshot["start_time_in_millis"], default=None)


def matches(name):
    return any(
        re.fullmatch(".*".join(re.escape(part) for part in pattern.split("*")), name)
        for pattern in RESTORE_CHECK_INDICES
    )


def drill_counts():
    """The document count of each index the drill restores."""
    rows = request(
        "GET",
        "/_cat/indices?format=json&bytes=b&h=index,pri.store.size"
        "&expand_wildcards=open",
    )
    sized = sorted(
        (int(row["pri.store.size"] or 0), row["index"])
        for row in rows
        if not row["index"].startswith((".", RESTORE_PREFIX))
        and row["index"] != COUNTS_INDEX
        and (not RESTORE_CHECK_INDICES or matches(row["index"]))
    )
    names = sorted(name for _, name in sized)
    if not RESTORE_CHECK_INDICES:
        names = [name for _, name in sized[:1]]
    if not names:
        return {}
    for batch in batches(names):
        request("POST", f"/{quoted(*batch)}/_refresh")
    return {name: request("GET", f"/{quoted(name)}/_count")["count"] for name in names}


def record_counts(name, counts):
    """Write the counts as the snapshot's document of the counts index."""
    if request("HEAD", f"/{quoted(COUNTS_INDEX)}", missing=True) is None:
        request("PUT", f"/{quoted(COUNTS_INDEX)}", COUNTS_INDEX_BODY)
    request(
        "PUT",
        f"/{quoted(COUNTS_INDEX)}/_doc/{quoted(name)}?refresh=true",
        {
            "service": SERVICE,
            "snapshot": name,
            "counts": [
                {"index": index, "documents": count} for index, count in counts.items()
            ],
        },
    )


def forget_counts(names):
    for name in names:
        request("DELETE", f"/{quoted(COUNTS_INDEX)}/_doc/{quoted(name)}", missing=True)


def wait_for(name):
    deadline = time.monotonic() + WAIT_SECONDS
    while True:
        answer = request("GET", f"/_snapshot/{quoted(REPOSITORY)}/{quoted(name)}")
        (snapshot,) = answer["snapshots"]
        if snapshot["state"] != "IN_PROGRESS":
            return snapshot
        if time.monotonic() > deadline:
            raise Failure(f"snapshot {name} still in progress after {WAIT_SECONDS} s")
        time.sleep(POLL_SECONDS)


def retention(taken):
    """Delete Cloudfall's snapshots older than retentionDays, never the newest."""
    snapshots = our_snapshots()
    kept = {taken, newest(snapshots)["snapshot"]}
    cutoff = (time.time() - RETENTION_DAYS * 86400) * 1000
    old = sorted(
        snapshot["snapshot"]
        for snapshot in snapshots
        if snapshot["start_time_in_millis"] < cutoff
        and snapshot["snapshot"] not in kept
        and snapshot["state"] != "IN_PROGRESS"
    )
    if old:
        for batch in batches(old):
            request("DELETE", f"/_snapshot/{quoted(REPOSITORY)}/{quoted(*batch)}")
            forget_counts(batch)
        print(
            f"retention {RETENTION_DAYS} days: deleted {len(old)} older "
            f"snapshots ({', '.join(old)}), kept {len(snapshots) - len(old)}"
        )
    else:
        print(
            f"retention {RETENTION_DAYS} days: no older snapshot to delete, "
            f"kept {len(snapshots)}"
        )


def backup():
    counts = drill_counts()
    name = time.strftime("cloudfall-%Y%m%d-%H%M%S", time.gmtime())
    record_counts(name, counts)
    try:
        request(
            "PUT",
            f"/_snapshot/{quoted(REPOSITORY)}/{quoted(name)}?wait_for_completion=false",
            {
                "include_global_state": True,
                "metadata": {"takenBy": "cloudfall", "service": SERVICE},
            },
        )
    except Failure:
        # No snapshot was started, so its counts describe nothing.
        forget_counts([name])
        raise
    snapshot = wait_for(name)
    shards = snapshot.get("shards", {})
    if snapshot["state"] != "SUCCESS":
        failures = "; ".join(
            str(failure.get("reason", failure)) for failure in snapshot.get("failures", [])
        )
        raise Failure(
            f"snapshot {name} of {SERVICE} ended {snapshot['state']}, not SUCCESS "
            f"({shards.get('failed', '?')} of {shards.get('total', '?')} shards failed)"
            + (f": {failures}" if failures else "")
        )
    if COUNTS_INDEX not in snapshot["indices"]:
        raise Failure(f"snapshot {name} does not hold {COUNTS_INDEX}")
    print(
        f"snapshot {name} of {SERVICE}: SUCCESS, {len(snapshot['indices'])} "
        f"indices, {shards.get('successful', 0)} of {shards.get('total', 0)} shards"
    )
    if counts:
        print(
            f"restore check will restore {len(counts)} indices, "
            f"{sum(counts.values())} documents"
        )
    else:
        print("no index to record for the restore check")
    retention(name)


def byte_size(value):
    found = re.fullmatch(r"([0-9]+(?:\.[0-9]+)?)\s*([kmgtp]?b)", value.strip().lower())
    if found is None:
        raise Failure(f"can't read the byte size {value!r}")
    return float(found[1]) * 1024 ** BYTE_UNITS[found[2]]


def required_free(total):
    """The free bytes the low disk watermark asks a node to keep."""
    answer = request(
        "GET", "/_cluster/settings?include_defaults=true&flat_settings=true"
    )

    def setting(key):
        for layer in ("transient", "persistent", "defaults"):
            if key in answer.get(layer, {}):
                return str(answer[layer][key])
        return None

    key = "cluster.routing.allocation.disk.watermark.low"
    low = setting(key)
    if low is None:
        raise Failure(f"the cluster settings hold no {key}")
    ratio = None
    if low.strip().endswith("%"):
        ratio = float(low.strip()[:-1]) / 100
    elif re.fullmatch(r"[0-9]*\.?[0-9]+", low.strip()):
        ratio = float(low)
    if ratio is None:
        return byte_size(low), low
    needed = total * (1 - ratio)
    headroom = setting(key + ".max_headroom")
    if headroom is not None and headroom.strip() != "-1":
        needed = min(needed, byte_size(headroom))
    return needed, low


def check_disk(size):
    answer = request("GET", "/_nodes/_local/stats/fs")
    (node,) = answer["nodes"].values()
    total = node["fs"]["total"]["total_in_bytes"]
    available = node["fs"]["total"]["available_in_bytes"]
    needed, low = required_free(total)
    if available - size < needed:
        raise Failure(
            f"restoring {size} bytes would leave {available - size} bytes free on "
            f"{node.get('name', 'the node')}, past the low disk watermark ({low}); "
            "free disk space or narrow restoreCheckIndices"
        )


def delete_copies(copies):
    """Delete the copies this drill restored; return those still there."""
    left = []
    for copy in copies:
        try:
            request("DELETE", f"/{quoted(copy)}", missing=True)
        except Failure as error:
            print(f"could not delete the restored copy {copy}: {error}", file=sys.stderr)
            left.append(copy)
    return left


def restore(name, indices, restored):
    """Restore ``indices`` of snapshot ``name`` as renamed copies and wait for green.

    Each copy's name is checked to be free first, so ``restored`` collects
    only copies this drill created, which are the only ones it deletes.
    """
    copies = [RESTORE_PREFIX + index for index in indices]
    taken = [
        copy
        for copy in copies
        if request("HEAD", f"/{quoted(copy)}", missing=True) is not None
    ]
    if taken:
        # Never restore over, or delete, an index this drill did not restore.
        raise Failure(
            f"{', '.join(taken)} already exist; the drill restores only under "
            "names nothing holds: delete them once you know they are an earlier "
            "drill's copies"
        )
    restored.extend(copies)
    answer = request(
        "POST",
        f"/_snapshot/{quoted(REPOSITORY)}/{quoted(name)}/_restore?wait_for_completion=true",
        {
            "indices": ",".join(indices),
            "include_global_state": False,
            "include_aliases": False,
            "rename_pattern": "(.+)",
            "rename_replacement": RESTORE_PREFIX + "$1",
            "index_settings": {"index.number_of_replicas": 0},
        },
    )
    shards = answer["snapshot"]["shards"]
    if shards["failed"]:
        raise Failure(
            f"restoring {name} failed {shards['failed']} of {shards['total']} shards"
        )
    for batch in batches(copies):
        health = request(
            "GET",
            f"/_cluster/health/{quoted(*batch)}?wait_for_status=green&timeout=60s",
            answers=(408,),
        )
        if health["status"] != "green":
            raise Failure(f"the restored copies are {health['status']}, not green")


def drill(snapshot, restored):
    name = snapshot["snapshot"]
    restore(name, [COUNTS_INDEX], restored)
    document = request(
        "GET",
        f"/{quoted(RESTORE_PREFIX + COUNTS_INDEX)}/_doc/{quoted(name)}",
        missing=True,
    )
    if document is None:
        raise Failure(f"snapshot {name} holds no recorded document counts")
    counts = {
        entry["index"]: entry["documents"] for entry in document["_source"]["counts"]
    }
    if not counts:
        raise Failure(f"snapshot {name} records no index to restore")
    absent = sorted(set(counts) - set(snapshot["indices"]))
    if absent:
        raise Failure(f"snapshot {name} does not hold {', '.join(absent)}")
    details = request(
        "GET",
        f"/_snapshot/{quoted(REPOSITORY)}/{quoted(name)}?index_details=true",
    )["snapshots"][0]["index_details"]
    check_disk(sum(details[index]["size_in_bytes"] for index in counts))
    restore(name, sorted(counts), restored)
    mismatched = []
    for index in sorted(counts):
        found = request("GET", f"/{quoted(RESTORE_PREFIX + index)}/_count")["count"]
        if found != counts[index]:
            mismatched.append(
                f"{index}: the snapshot recorded {counts[index]} documents, "
                f"the restore brought back {found}"
            )
    if mismatched:
        raise Failure(
            f"restore check failed for {SERVICE}: snapshot {name}; "
            + "; ".join(mismatched)
        )
    return counts


def restore_check():
    request("POST", f"/_snapshot/{quoted(REPOSITORY)}/_verify")
    snapshot = newest(our_snapshots())
    if snapshot is None:
        raise Failure(
            f"no snapshot exists in repository {REPOSITORY} that Cloudfall took "
            f"of {SERVICE} with state SUCCESS; run cloudfall backup run {SERVICE} first"
        )
    if COUNTS_INDEX not in snapshot["indices"]:
        raise Failure(f"snapshot {snapshot['snapshot']} does not hold {COUNTS_INDEX}")
    restored = []
    try:
        counts = drill(snapshot, restored)
    finally:
        left = delete_copies(restored)
    if left:
        raise Failure(f"the restored copies {', '.join(left)} are still there")
    print(
        f"restore check passed for {SERVICE}: snapshot {snapshot['snapshot']} "
        f"restored {len(counts)} indices ({', '.join(sorted(counts))}) with "
        f"{sum(counts.values())} documents, as recorded; the restored copies "
        "are deleted"
    )


def stop(signum, frame):
    raise Failure(f"stopped by signal {signum}")


def main():
    global AUTHORIZATION
    signal.signal(signal.SIGTERM, stop)
    try:
        AUTHORIZATION = authorization()
        if ACTION == "backup":
            backup()
        elif ACTION == "restore-check":
            restore_check()
        else:
            raise Failure(f"unknown action {ACTION!r}")
    except Failure as error:
        print(f"{ACTION} of {SERVICE} failed: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
