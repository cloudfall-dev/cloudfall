# Managed by Cloudfall for service {{ cloudfall_elasticsearch_service.id }};
# a change made here is overwritten by the next converge.
#
# One node is a cluster of one (S-012): never discovery.type: single-node, so
# growing it is adding a node. cluster.initial_master_nodes is written only
# for the home node until it has served its cluster once, and leaves this
# file in that same converge.
cluster.name: {{ cloudfall_elasticsearch_service.elasticsearch.clusterName | to_json }}
node.name: {{ cloudfall_server_id | to_json }}
path.data: {{ cloudfall_elasticsearch_data_path | to_json }}
path.logs: {{ cloudfall_elasticsearch_log_path | to_json }}
bootstrap.memory_lock: true
network.host: {{ cloudfall_elasticsearch_service.bind.address | to_json }}
http.port: {{ cloudfall_elasticsearch_service.bind.port }}
{% if cloudfall_elasticsearch_node_transport %}
# A cluster of two or more: HTTP stays on loopback, the transport listens on
# this node's address, open to the other nodes only, and every connection
# between nodes is TLS both ways, verified against the project CA by name.
transport.host: {{ cloudfall_elasticsearch_node_transport.address | to_json }}
transport.port: {{ cloudfall_elasticsearch_node_transport.port }}
discovery.seed_hosts: {{ cloudfall_elasticsearch_node_transport.seedHosts | to_json }}
{% else %}
discovery.seed_hosts: {{ [cloudfall_elasticsearch_service.bind.address] | to_json }}
{% endif %}
{% if cloudfall_elasticsearch_bootstrap | bool %}
cluster.initial_master_nodes: {{ [cloudfall_server_id] | to_json }}
{% endif %}
xpack.security.enabled: true
xpack.security.enrollment.enabled: false
xpack.security.http.ssl.enabled: false
{% if cloudfall_elasticsearch_node_transport %}
xpack.security.transport.ssl.enabled: true
xpack.security.transport.ssl.verification_mode: full
xpack.security.transport.ssl.client_authentication: required
xpack.security.transport.ssl.key: {{ cloudfall_elasticsearch_node_transport.keyPath | to_json }}
xpack.security.transport.ssl.certificate: {{ cloudfall_elasticsearch_node_transport.certificatePath | to_json }}
xpack.security.transport.ssl.certificate_authorities: {{ [cloudfall_elasticsearch_node_transport.caPath] | to_json }}
{% else %}
xpack.security.transport.ssl.enabled: false
{% endif %}
